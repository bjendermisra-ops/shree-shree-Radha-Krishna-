{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/app",
      "destination": "https://play.google.com/store/apps/details?id=com.iskcon.hadapsar.santosh.in",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://responsivetesttool.com https://www.responsivetesttool.com https://*.responsivetesttool.com https://responsivetool.com https://www.responsivetool.com"
        }
      ]
    }
  ]
}
